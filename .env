# ============================================
# Enterprise E-commerce Frontend - Environment Variables
# ============================================
# This file contains values for local development
# Commit this file to version control
# ============================================

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=eShop

# ============================================
# Backend API Configuration
# ============================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082
NEXT_PUBLIC_API_AUTH_URL=http://localhost:8082/api/auth
NEXT_PUBLIC_API_URL=http://localhost:8082/api/v1
INTERNAL_API_URL=http://127.0.0.1:8082
BACKEND_API_URL=http://localhost:8082

# ============================================
# Authentication (NextAuth.js)
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-key-for-local-dev-only
SESSION_SECRET=dev-secret-key-for-local-dev-only

# ============================================
# Keycloak OAuth Configuration
# ============================================
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=eshop
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=eshop-client
NEXT_PUBLIC_USE_KEYCLOAK_LOGOUT=false
NEXT_PUBLIC_ENABLE_OAUTH=true

KEYCLOAK_ISSUER=http://localhost:8080/realms/eshop
KEYCLOAK_CLIENT_ID=eshop-client
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=eshop
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback
NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
