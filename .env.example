# ============================================
# Enterprise E-commerce Frontend - Environment Variables Template
# ============================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT
# Do not commit .env.local to version control (.gitignore should include it)
# ============================================

# ============================================
# Application URLs
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=E-Commerce Platform

# ============================================
# Backend API Configuration
# ===========================================
# Base URL for API requests. Required in production and staging environments (e.g. https://api.example.com).
NEXT_PUBLIC_API_URL=http://localhost:8082/api/v1
# Optional: API version prefix. Default: v1
NEXT_PUBLIC_API_VERSION=v1
# Optional: WebSocket (socket.io) server origin, for infrastructure/realtime/websocket-client.ts.
# Behind nginx in production this is typically the same origin as NEXT_PUBLIC_API_URL
# (WS traffic routed through nginx's /socket.io/ location — see eshop_back's nginx.conf).
NEXT_PUBLIC_WS_URL=http://localhost:8090
# Required: Deployment environment. Valid values: development | staging | production
NEXT_PUBLIC_APP_ENV=development
# Optional: force verbose API-config debug logging even in production. Defaults to false.
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8082
NEXT_PUBLIC_API_AUTH_URL=http://localhost:8082/api/auth
NEXT_PUBLIC_API_TIMEOUT=30000
INTERNAL_API_URL=http://127.0.0.1:8082
BACKEND_API_URL=http://localhost:8082
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-custom-domain.com

# ============================================
# Authentication (NextAuth.js)
# ===========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
# Only set to 'true' behind a trusted reverse proxy in production. Defaults to
# trusted in development/test regardless of this value.
AUTH_TRUST_HOST=false
# Session cookie lifetime. Separate from the Keycloak access token's own
# (much shorter) expiry, which is refreshed independently.
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# Optional. If set (see UPSTASH_REDIS_REST_URL/TOKEN below), token refresh
# uses a distributed lock so concurrent requests across multiple instances
# don't race Keycloak's refresh endpoint with the same (single-use) refresh
# token. Falls back to a process-local-only lock if unset.

# Token-refresh resilience tuning — all optional, defaults shown below.
AUTH_REFRESH_MAX_RETRIES=2
AUTH_REFRESH_BASE_DELAY_MS=500
AUTH_REFRESH_TIMEOUT_MS=5000
AUTH_REFRESH_BUFFER_SECONDS=10
AUTH_BACKEND_ROLE_TIMEOUT_MS=2000
AUTH_BACKEND_ROLE_MAX_RETRIES=1
AUTH_BACKEND_ROLE_BASE_DELAY_MS=200
# Per-request timeout for each individual Upstash Redis call the
# distributed lock above makes. Bounds a misconfigured/unreachable
# UPSTASH_REDIS_REST_URL to a fast failure instead of the SDK's own
# (much longer) default — see lib/auth/token-refresh.ts.
AUTH_DIST_LOCK_TIMEOUT_MS=2000

# ============================================
# Redis (Upstash) — optional
# ===========================================
# Shared by rate limiting (shared/utils/rate-limit.ts) and the distributed
# token-refresh lock (lib/auth/token-refresh.ts). Both degrade gracefully
# (in-memory fallback) if left unset — only needed for multi-instance
# deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# Payments (Stripe)
# ===========================================
# Optional — Stripe payments are an opt-in feature. The publishable key is
# safe to expose client-side (infrastructure/payments/stripe-client.ts).
# The secret key and webhook secret are server-only and must never be
# exposed to the client (infrastructure/payments/stripe-server.ts,
# app/api/webhooks/stripe/route.ts). All three should be set together —
# leaving the secret/webhook keys unset while the publishable key is set
# would mean checkout renders a Stripe Elements form but the webhook route
# can never verify Stripe's callbacks.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# Keycloak OAuth Configuration
# ===========================================
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=eshop
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=eshop-client
NEXT_PUBLIC_USE_KEYCLOAK_LOGOUT=false
NEXT_PUBLIC_ENABLE_OAUTH=true

# Server-side Keycloak (used by NextAuth)
KEYCLOAK_ISSUER=http://localhost:8080/realms/eshop
KEYCLOAK_CLIENT_ID=eshop-client
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=eshop
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback
NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# ============================================
# Site Metadata (Optional)
# ===========================================
# NEXT_PUBLIC_SITE_LOCALE=en-US
# NEXT_PUBLIC_SITE_AUTHOR_NAME=eShop Team
# NEXT_PUBLIC_SITE_AUTHOR_EMAIL=team@example.com
# NEXT_PUBLIC_SITE_TWITTER=@eshop
# NEXT_PUBLIC_SITE_LINK_TWITTER=https://twitter.com/eshop
# NEXT_PUBLIC_SITE_LINK_GITHUB=https://github.com/eshop
# NEXT_PUBLIC_SITE_LINKEDIN=https://linkedin.com/company/eshop
# NEXT_PUBLIC_SITE_LINK_FACEBOOK=https://facebook.com/eshop
# NEXT_PUBLIC_SITE_LINK_INSTAGRAM=https://instagram.com/eshop

# ============================================
# Feature Flags
# ============================================
# Gates the server-side email-verification redirect on /account/profile.
# Requires a real /account/verify-email page to exist before enabling —
# it doesn't yet, so leave this false until that page is built.
REQUIRE_EMAIL_VERIFICATION=false

# ============================================
# Application Info
# ===========================================
NODE_ENV=development
APP_VERSION=1.0.0
SERVICE_NAME=ecommerce-frontend

# ============================================
# Logging & Observability
# ===========================================
LOG_LEVEL=info

# ============================================
# Sentry Error Tracking (Optional)
# ===========================================
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ============================================
# Feature Flags (Optional)
# ===========================================
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_CHAT=false

# ============================================
# Third-Party Services (Optional)
# ===========================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ============================================
# Application Configuration Defaults
# ============================================
# ISO 4217 three-letter currency code. Default: INR
# Examples: INR, USD, EUR, GBP, JPY
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Display symbol for the default currency. Max 5 characters. Default: ₹
# Examples: ₹, $, €, £
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL=₹

# BCP 47 locale code for rendering and formatting. Default: en-IN
# Examples: en-IN, en-US, de-DE, ja-JP
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# Default items per page. Default: 20
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Max items per page. Default: 100
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# ==========================================================================
# SELLER LANDING PAGE — HEADLINE METRICS (all optional)
# ==========================================================================
# Figures shown on /seller/register. Each is OPT-IN: leave a value blank and
# that metric is not displayed at all.
#
# [COMPLIANCE] These are advertising representations made to prospective
# merchants. Under India's Consumer Protection Act 2019 and the ASCI code, an
# objective claim must be substantiable on demand. Only populate a value you
# can evidence, and re-verify the measured ones (seller count, verification
# SLA) on a regular cadence. They were previously hardcoded in JSX with
# invented values; do not reintroduce defaults here.

# Measured — requires periodic re-substantiation.
NEXT_PUBLIC_SELLER_COUNT=
NEXT_PUBLIC_SELLER_COUNT_SCOPE=
NEXT_PUBLIC_SELLER_VERIFICATION_SLA=

# Policy — true by construction, but must still match the published terms.
NEXT_PUBLIC_SELLER_SIGNUP_MINUTES=
NEXT_PUBLIC_SELLER_COMMISSION_RATE=
