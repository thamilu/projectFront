{
  "name": "ecommerce-enterprise-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise e-commerce frontend built with Next.js 16, React 19, and TypeScript",
  "author": "Enterprise Team <team@example.com>",
  "license": "UNLICENSED",
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.18.0 <=24.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "dev:webpack": "next dev --webpack",
    "dev:prod-check": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "========== Build ==========": "",
    "build": "next build && node scripts/sentry-upload.js",
    "build:webpack": "next build --webpack && node scripts/sentry-upload.js",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "========== Testing ==========": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html --coverageReporters=lcov",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:a11y": "jest --testMatch='**/*.a11y.test.tsx'",
    "test:a11y:ci": "pa11y-ci --config .pa11yci.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --update-snapshots",
    "test:visual:ci": "playwright test --reporter=html",
    "========== Quality ==========": "",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "type-check": "tsc --noEmit --incremental",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test:ci && npm run test:a11y",
    "========== Security ==========": "",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:production": "npm audit --production --audit-level=high",
    "gen:sbom": "cyclonedx-npm --output-file sbom.json",
    "check:licenses": "license-checker --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Unlicense' --summary",
    "ci:security": "npm run audit:production && npm run check:licenses && npm run gen:sbom",
    "========== Architecture ==========": "",
    "check:architecture": "depcruise --config .dependency-cruiser.json features shared lib app",
    "check:dead-code": "knip",
    "check:budgets": "node scripts/check-bundle-budgets.js",
    "check:env": "tsx ./scripts/validate-env.ts",
    "check:icons": "tsx ./scripts/generate-lucide-types.ts --check",
    "check:keycloak": "tsx ./scripts/verify-keycloak-setup.ts",
    "check:keycloak-live": "tsx ./scripts/verify-keycloak-live.ts",
    "========== Code Generation ==========": "",
    "gen:lucide-types": "tsx ./scripts/generate-lucide-types.ts",
    "gen:api-types": "node scripts/generate-api-types.js",
    "check:api-types": "node scripts/generate-api-types.js --check --offline",
    "========== Dependencies ==========": "",
    "deps:check": "npm outdated",
    "deps:dedupe": "npm dedupe",
    "deps:why": "npm ls",
    "deps:update:patch": "npm update --save",
    "deps:update:minor": "npx npm-check-updates -u --target minor && npm install",
    "deps:maintain": "npm run deps:dedupe && npm run deps:check && npm audit",
    "ci:no-dupes": "npm ls --depth=999 2>&1 | grep -q 'deduped' && exit 1 || exit 0",
    "========== Monitoring ==========": "",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --org=$SENTRY_ORG --project=$SENTRY_PROJECT .next",
    "sentry:release": "sentry-cli releases new $npm_package_version",
    "sentry:set-commits": "sentry-cli releases set-commits $npm_package_version --auto",
    "sentry:finalize": "sentry-cli releases finalize $npm_package_version",
    "sentry:deploy": "node scripts/sentry-deploy.js",
    "sentry:full": "npm run sentry:release && npm run sentry:set-commits && npm run sentry:sourcemaps && npm run sentry:finalize",
    "lighthouse:ci": "lhci autorun --config=.lighthouserc.json",
    "========== Deployment ==========": "",
    "health:check": "node scripts/health-check.js",
    "smoke:test": "playwright test __tests__/e2e/smoke/",
    "warmup": "node scripts/warmup-pages.js",
    "deploy:verify": "npm run health:check && npm run smoke:test && npm run warmup",
    "deploy": "npm run build && npm run sentry:full && node scripts/sentry-deploy.js",
    "========== CI/CD ==========": "",
    "install:clean": "rimraf node_modules package-lock.json && npm install",
    "ci:install": "npm ci --prefer-offline",
    "ci:preflight": "npm run check:env",
    "ci:verify-install": "node -e \"if(!require('fs').existsSync('package-lock.json')){console.error('❌ package-lock.json missing');process.exit(1)}\"",
    "ci": "npm run ci:verify-install && npm ci --prefer-offline && npm run ci:security && npm run ci:preflight && npm run validate && npm run build && npm run check:budgets && npm run lighthouse:ci",
    "========== Maintenance ==========": "",
    "clean": "rimraf .next .turbopack node_modules/.cache",
    "clean:full": "npm run clean && rimraf node_modules package-lock.json",
    "prepare": "husky",
    "postinstall": "npm dedupe --engine-strict=false || true",
    "preinstall": "node -e \"if(process.env.CI && process.env.npm_command !== 'ci'){console.error('❌ Use npm ci in CI');process.exit(1)}\"",
    "========== Utilities ==========": "",
    "commit": "cz"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "10.2.9",
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.4.1",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/nextjs": "10.32.1",
    "@stripe/react-stripe-js": "3.5.0",
    "@stripe/stripe-js": "9.4.0",
    "@t3-oss/env-nextjs": "0.10.1",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-query": "5.62.0",
    "@tanstack/react-query-devtools": "5.62.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "axios": "1.20.0",
    "axios-retry": "4.5.0",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "focus-trap-react": "12.0.2",
    "framer-motion": "12.34.3",
    "isomorphic-dompurify": "2.34.0",
    "jose": "6.1.3",
    "leaflet": "1.9.4",
    "lucide-react": "0.562.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.69.0",
    "react-leaflet": "5.0.0",
    "socket.io-client": "4.8.1",
    "sonner": "2.0.7",
    "stripe": "22.6.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@cyclonedx/cyclonedx-npm": "1.19.3",
    "@lhci/cli": "0.15.0",
    "@next/bundle-analyzer": "16.1.0",
    "@next/env": "16.1.0",
    "@playwright/test": "1.48.0",
    "@sentry/cli": "2.38.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.0",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.0",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/leaflet": "1.9.21",
    "@types/node": "20.17.12",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "autoprefixer": "10.4.23",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "dependency-cruiser": "16.10.0",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-server-components": "1.2.0",
    "husky": "9.1.0",
    "jest": "30.2.0",
    "jest-axe": "9.0.0",
    "jest-environment-jsdom": "30.2.0",
    "knip": "6.14.1",
    "license-checker": "25.0.1",
    "lint-staged": "15.2.0",
    "openapi-typescript": "7.13.0",
    "openapi-zod-client": "1.18.3",
    "pa11y-ci": "3.1.0",
    "postcss": "8.5.6",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rimraf": "6.1.2",
    "tailwindcss": "4.1.18",
    "ts-jest": "29.4.6",
    "tsx": "4.19.0",
    "turbo": "2.3.3",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "node -e \"require('child_process').execSync('tsc --noEmit', {stdio:'inherit'})\""
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
